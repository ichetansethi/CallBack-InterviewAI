# Copy to .env (gitignored) and fill in. docker compose reads it automatically.

# Required. Groq key used by question-service, compatibility-service,
# session-history-service and voice-orchestrator.
GROQ_API_KEY=

# Postgres superuser created by the postgres container; every service connects with it.
DB_USERNAME=callback_admin
DB_PASSWORD=callback_password123

# whisper.cpp in a container is CPU-only (~10x slower than the host's Metal; measured
# 2026-10-17). To use a host whisper-server instead, point this at it and start the
# stack without the whisper service.
WHISPER_BASE_URL=http://whisper:8090
